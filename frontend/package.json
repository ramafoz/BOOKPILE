{
  "name": "bookpile-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:server",
    "dev:local": "vite --mode edition-local",
    "dev:server": "vite --mode edition-server",
    "build": "npm run build:server",
    "build:local": "tsc -b && vite build --mode edition-local",
    "build:server": "tsc -b && vite build --mode edition-server",
    "build:all": "npm run build:local && npm run build:server",
    "lint": "eslint .",
    "test": "vitest run",
    "test:local": "vitest run --config vitest.local.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "preview": "npm run preview:server",
    "preview:local": "vite preview --mode edition-local",
    "preview:server": "vite preview --mode edition-server"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
