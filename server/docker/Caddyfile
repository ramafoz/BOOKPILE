{
	http_port 8080
	https_port 8443
	admin off
	email {$BOOKPILE_TLS_EMAIL}
}

{$BOOKPILE_SITE_ADDRESS} {
	encode zstd gzip

	# Keep short-lived edge evidence without retaining headers, cookies or query
	# strings. API and health traffic has its own normalized application log.
	log access_log {
		output file /data/access.log {
			mode 0600
			roll_size 10mb
			# Caddy 2.11 time-rolls even when traffic is too low to reach 10 MiB.
			# UTC is the default because roll_local_time is deliberately omitted.
			roll_at 00:00
			roll_keep 14
			roll_keep_for 336h
		}
		format filter {
			request>uri delete
			request>headers delete
			resp_headers delete
			health_class delete
			defensive_decision delete
			client_ip delete
			wrap json
		}
		no_hostname
	}

	# D6 consumes a separate, deliberately tiny event stream. The named logger
	# is not associated with a hostname: every request opts into both logs
	# explicitly below, so a configuration edit cannot silently duplicate or
	# omit one class. Caddy's fundamental ts/level/logger/msg fields cannot be
	# filtered; every other built-in request/response field is deleted.
	log d6_defensive {
		output file /var/log/bookpile/defensive-events.log {
			mode 0600
			roll_size 10mb
			roll_at 00:00
			roll_keep 14
			roll_keep_for 336h
		}
		format filter {
			request delete
			bytes_read delete
			user_id delete
			duration delete
			size delete
			status delete
			resp_headers delete
			request_path delete
			wrap json
		}
		no_hostname
	}

	# Map the path once to one value. Unlike three independent matchers, this
	# table cannot assign one request to two health classes. Query parameters
	# are not part of http.request.uri.path and are never copied to either log.
	map {http.request.uri.path} {bookpile_health_class} {
		/health/live live
		/health/ready ready
		default other
	}
	log_name access_log d6_defensive
	log_append deployment_revision {$BOOKPILE_DEPLOYMENT_REVISION}
	log_append health_class {bookpile_health_class}
	log_append defensive_decision observed
	# D6 must eventually count and temporarily block a validated network
	# address. Keep only Caddy's effective client IP: never retain the remote
	# port, forwarding headers, authenticated identity or request identifier.
	log_append client_ip {client_ip}
	# Preserve edge-only 413/502 evidence while avoiding raw API identifiers.
	@api_traffic path /api/*
	log_append @api_traffic request_path /api/*
	@health_traffic path /health*
	log_append @health_traffic request_path /health*
	@browser_traffic {
		not path /api/* /health*
	}
	log_append @browser_traffic request_path {orig_path}

	request_body {
		max_size 110MB
	}

	@scanner_probe path_regexp scanner_probe (?i)^/(?:\.env(?:[./].*)?|\.git(?:/.*)?|wp-admin(?:/.*)?|wp-login\.php|phpmyadmin(?:/.*)?)$
	handle @scanner_probe {
		log_append event_class scanner_probe
		log_append policy_scope scanner_probe
		log_append deployment_revision {$BOOKPILE_DEPLOYMENT_REVISION}
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8100 {
			transport http {
				dial_timeout 5s
				response_header_timeout 15m
			}
		}
	}

	handle /health* {
		# Caddy ignores client-supplied X-Forwarded-* values by default. The API
		# accepts its sanitized address only from configured private proxy CIDRs.
		reverse_proxy api:8100
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		X-Permitted-Cross-Domain-Policies none
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; img-src 'self' blob: data:; media-src 'self' blob:; script-src 'self'; style-src 'self'; connect-src 'self'; worker-src 'self' blob:"
	}

	@versioned_assets path /assets/*
	header @versioned_assets Cache-Control "public, max-age=31536000, immutable"
	@spa_entry path / /index.html
	header @spa_entry Cache-Control "no-cache"
}
