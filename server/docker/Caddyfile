{
	http_port 8080
	https_port 8443
	admin off
	email {$BOOKPILE_TLS_EMAIL}
}

{$BOOKPILE_SITE_ADDRESS} {
	encode zstd gzip

	# Keep short-lived edge evidence without retaining headers, cookies or query
	# strings. API and health traffic has its own normalized application log.
	log {
		output file /data/access.log {
			mode 0600
			roll_size 10mb
			# Caddy 2.11 time-rolls even when traffic is too low to reach 10 MiB.
			# UTC is the default because roll_local_time is deliberately omitted.
			roll_at 00:00
			roll_keep 14
			roll_keep_for 336h
		}
		format filter {
			request>uri delete
			request>headers delete
			resp_headers delete
			wrap json
		}
	}
	# Preserve edge-only 413/502 evidence while avoiding raw API identifiers.
	@api_traffic path /api/*
	log_append @api_traffic request_path /api/*
	@health_traffic path /health*
	log_append @health_traffic request_path /health*
	@browser_traffic {
		not path /api/* /health*
	}
	log_append @browser_traffic request_path {orig_path}

	request_body {
		max_size 110MB
	}

	@scanner_probe path_regexp scanner_probe (?i)^/(?:\.env(?:[./].*)?|\.git(?:/.*)?|wp-admin(?:/.*)?|wp-login\.php|phpmyadmin(?:/.*)?)$
	handle @scanner_probe {
		log_append event_class scanner_probe
		log_append policy_scope scanner_probe
		log_append deployment_revision {$BOOKPILE_DEPLOYMENT_REVISION}
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8100 {
			transport http {
				dial_timeout 5s
				response_header_timeout 15m
			}
		}
	}

	handle /health* {
		# Caddy ignores client-supplied X-Forwarded-* values by default. The API
		# accepts its sanitized address only from configured private proxy CIDRs.
		reverse_proxy api:8100
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		X-Permitted-Cross-Domain-Policies none
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; img-src 'self' blob: data:; media-src 'self' blob:; script-src 'self'; style-src 'self'; connect-src 'self'; worker-src 'self' blob:"
	}

	@versioned_assets path /assets/*
	header @versioned_assets Cache-Control "public, max-age=31536000, immutable"
	@spa_entry path / /index.html
	header @spa_entry Cache-Control "no-cache"
}
