# Copy to /etc/bookpile/healthchecks-maintenance.curl with owner root:root and mode 600.
# Replace only the URL. Treat the UUID in it as a secret; do not commit the filled file.
url = "https://hc-ping.com/replace-with-private-ping-uuid"
proto = "=https"
connect-timeout = 5
max-time = 10
silent
show-error
fail
