[Unit]
Description=BOOKPILE immutable administration audit 365-day retention
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/bookpileadmin/b
ExecStart=/usr/bin/docker compose --env-file server/.env.staging -f server/compose.production.yaml --profile administration run --rm admin-audit-retention
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/bookpileadmin/b
