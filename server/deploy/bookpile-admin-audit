#!/usr/bin/env python3
"""Root-only bridge to the isolated BOOKPILE administration audit writer."""

import json
import os
from pathlib import Path
import socket
import stat
import sys


SOCKET_PATH = Path("/run/bookpile-admin-audit/audit.sock")
COMMANDS = frozenset({"append-host-evidence-access"})
MAX_MESSAGE = 65_536


def fail(message: str) -> int:
    print(message, file=sys.stderr)
    return 1


def main() -> int:
    if os.geteuid() != 0:
        return fail("admin audit access requires root")
    if len(sys.argv) != 2 or sys.argv[1] not in COMMANDS:
        return fail("admin audit command is not allowed")
    try:
        details = SOCKET_PATH.lstat()
    except OSError:
        return fail("admin audit recorder is unavailable")
    if (
        not stat.S_ISSOCK(details.st_mode)
        or details.st_uid != 10001
        or stat.S_IMODE(details.st_mode) != 0o600
    ):
        return fail("admin audit recorder socket is unsafe")

    payload: object | None = None
    if sys.argv[1] == "append-host-evidence-access":
        content = sys.stdin.read(MAX_MESSAGE + 1)
        if not content or len(content) > MAX_MESSAGE:
            return fail("admin audit input is empty or too large")
        try:
            payload = json.loads(content)
        except json.JSONDecodeError:
            return fail("admin audit input is not valid JSON")
    request = json.dumps(
        {"command": sys.argv[1], "payload": payload},
        sort_keys=True,
        separators=(",", ":"),
    ).encode() + b"\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(5)
            client.connect(str(SOCKET_PATH))
            client.sendall(request)
            response_bytes = b""
            while not response_bytes.endswith(b"\n"):
                chunk = client.recv(MAX_MESSAGE + 1 - len(response_bytes))
                if not chunk:
                    break
                response_bytes += chunk
                if len(response_bytes) > MAX_MESSAGE:
                    return fail("admin audit response is too large")
    except OSError:
        return fail("admin audit recorder failed")
    try:
        response = json.loads(response_bytes)
    except (json.JSONDecodeError, UnicodeDecodeError):
        return fail("admin audit recorder returned an invalid response")
    if not isinstance(response, dict) or response.get("ok") is not True:
        return fail("admin audit recorder rejected access")
    print(json.dumps(response["result"], sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
