# Copy to server/.env.staging on the staging host and chmod 600.
# Values in this file are examples or placeholders, never usable secrets.
BOOKPILE_ENV_FILE=.env.staging
BOOKPILE_BACKUP_ENV_FILE=.env.staging.backup

BOOKPILE_SERVER_ENVIRONMENT=staging
BOOKPILE_SERVER_DEPLOYMENT_REVISION=replace-with-exact-git-commit
BOOKPILE_SERVER_PUBLIC_BASE_URL=https://staging.bookpile.gal
BOOKPILE_SERVER_ALLOWED_HOSTS=staging.bookpile.gal
BOOKPILE_SERVER_API_DOCS_ENABLED=false
BOOKPILE_SERVER_SESSION_COOKIE_SECURE=true
BOOKPILE_SERVER_SESSION_COOKIE_NAME=bookpile_staging_session
BOOKPILE_SERVER_CSRF_COOKIE_NAME=bookpile_staging_csrf
BOOKPILE_SERVER_RATE_LIMIT_KEY_SECRET=replace-with-independent-32-character-secret

BOOKPILE_POSTGRES_PASSWORD=replace-with-url-safe-random-database-password
BOOKPILE_SERVER_DATABASE_URL=postgresql+psycopg://bookpile:replace-with-url-safe-random-database-password@db:5432/bookpile
BOOKPILE_SERVER_DATABASE_POOL_SIZE=5
BOOKPILE_SERVER_DATABASE_MAX_OVERFLOW=5
BOOKPILE_SERVER_DATABASE_POOL_RECYCLE_SECONDS=1800

# Dinahosting staging-only 1 GB S3 account and dedicated private bucket.
BOOKPILE_SERVER_PRIVATE_OBJECT_BACKEND=s3
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ENDPOINT_URL=https://objects.dinaserver.com
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_REGION=us-east-1
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_BUCKET=bookpile-staging-private
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ACCESS_KEY_ID=replace-with-staging-key
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_SECRET_ACCESS_KEY=replace-with-staging-secret
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_PREFIX=staging
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ADDRESSING_STYLE=path
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_CONNECT_TIMEOUT_SECONDS=3
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_READ_TIMEOUT_SECONDS=10
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_MAX_ATTEMPTS=3
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_MAX_CONNECTIONS=10

# Dinahosting Hosting Correo: implicit TLS and at least 10 seconds between messages.
BOOKPILE_SERVER_SMTP_HOST=bookpile-gal.correoseguro.dinaserver.com
BOOKPILE_SERVER_SMTP_PORT=465
BOOKPILE_SERVER_SMTP_FROM_EMAIL=BOOKPILE <hello@bookpile.gal>
BOOKPILE_SERVER_SMTP_STARTTLS=false
BOOKPILE_SERVER_SMTP_IMPLICIT_TLS=true
BOOKPILE_SERVER_SMTP_USERNAME=hello@bookpile.gal
BOOKPILE_SERVER_SMTP_PASSWORD=replace-with-mailbox-password
BOOKPILE_SERVER_SMTP_TIMEOUT_SECONDS=10
BOOKPILE_EMAIL_WORKER_PROCESSED_DELAY_SECONDS=11
BOOKPILE_SERVER_EMAIL_DELIVERY_MODE=outbox
BOOKPILE_SERVER_EMAIL_OUTBOX_ENCRYPTION_SECRET=replace-with-independent-32-character-secret
BOOKPILE_SERVER_EMAIL_OUTBOX_MAX_ATTEMPTS=8
BOOKPILE_SERVER_EMAIL_OUTBOX_LEASE_SECONDS=120

BOOKPILE_SITE_ADDRESS=https://staging.bookpile.gal
BOOKPILE_TLS_EMAIL=replace-with-private-operations-email
