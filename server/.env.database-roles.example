# Copy to server/.env.database-roles, chmod 600, and keep every value independent.
BOOKPILE_DATABASE_MIGRATOR_URL=postgresql://bookpile:replace-migrator-password@db:5432/bookpile
BOOKPILE_DATABASE_APP_PASSWORD=replace-with-independent-32-character-password
BOOKPILE_DATABASE_ADMIN_AUDIT_WRITER_PASSWORD=replace-with-independent-32-character-password
BOOKPILE_DATABASE_ADMIN_AUDIT_VERIFIER_PASSWORD=replace-with-independent-32-character-password
BOOKPILE_DATABASE_ADMIN_AUDIT_RETENTION_PASSWORD=replace-with-independent-32-character-password
