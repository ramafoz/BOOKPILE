# Copy to .env.backup with mode 600. Only the backup job receives this file.
BOOKPILE_SERVER_DEPLOYMENT_REVISION=replace-with-git-commit
BOOKPILE_SERVER_DATABASE_URL=postgresql+psycopg://bookpile_backup:replace-read-only-password@db:5432/bookpile

# Dedicated read/list credential for active private objects.
BOOKPILE_SERVER_PRIVATE_OBJECT_BACKEND=s3
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ENDPOINT_URL=https://s3.example-provider.es
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_REGION=replace-with-provider-region
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_BUCKET=replace-with-private-bucket
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ACCESS_KEY_ID=replace-with-backup-source-read-key
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_SECRET_ACCESS_KEY=replace-with-backup-source-read-secret
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_PREFIX=production
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ADDRESSING_STYLE=auto

# A separate failure domain receives only encrypted artefacts.
BOOKPILE_SERVER_OPERATIONAL_BACKUP_ENCRYPTION_SECRET=replace-with-off-host-custodied-32-character-secret
BOOKPILE_SERVER_OPERATIONAL_BACKUP_ENCRYPTION_KEY_ID=backup-key-2026-01
BOOKPILE_SERVER_OPERATIONAL_BACKUP_RETENTION_DAYS=29
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_ENDPOINT_URL=https://replace-with-backup-object-storage
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_REGION=replace-with-region
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_BUCKET=replace-with-separate-backup-bucket
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_ACCESS_KEY_ID=replace-with-backup-access-key
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_SECRET_ACCESS_KEY=replace-with-backup-secret-key
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_PREFIX=bookpile-operational-backups
BOOKPILE_SERVER_OPERATIONAL_BACKUP_OBJECT_LOCK_ENABLED=true
