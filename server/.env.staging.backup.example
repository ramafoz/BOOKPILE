# Copy to server/.env.staging.backup on the staging host and chmod 600.
# This file is supplied only to the isolated backup container.
BOOKPILE_SERVER_DEPLOYMENT_REVISION=replace-with-exact-git-commit
BOOKPILE_SERVER_DATABASE_URL=postgresql+psycopg://bookpile_backup:replace-with-url-safe-read-only-password@db:5432/bookpile

# Read-only source credential for the Arsys active-object bucket.
BOOKPILE_SERVER_PRIVATE_OBJECT_BACKEND=s3
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ENDPOINT_URL=https://replace-with-arsys-s3-endpoint
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_REGION=replace-with-arsys-region
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_BUCKET=bookpile-staging-private
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ACCESS_KEY_ID=replace-with-staging-backup-reader
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_SECRET_ACCESS_KEY=replace-with-reader-secret
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_PREFIX=staging
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ADDRESSING_STYLE=auto

# Backblaze B2 EU Central bucket created with Object Lock enabled.
BOOKPILE_SERVER_OPERATIONAL_BACKUP_ENCRYPTION_SECRET=replace-with-off-host-custodied-32-character-secret
BOOKPILE_SERVER_OPERATIONAL_BACKUP_ENCRYPTION_KEY_ID=staging-backup-key-2026-01
BOOKPILE_SERVER_OPERATIONAL_BACKUP_RETENTION_DAYS=29
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_ENDPOINT_URL=https://replace-with-eu-central-b2-endpoint
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_REGION=replace-with-b2-region
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_BUCKET=bookpile-staging-operational-backups
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_ACCESS_KEY_ID=replace-with-bucket-key-id
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_SECRET_ACCESS_KEY=replace-with-bucket-application-key
BOOKPILE_SERVER_OPERATIONAL_BACKUP_S3_PREFIX=staging-operational-backups
BOOKPILE_SERVER_OPERATIONAL_BACKUP_OBJECT_LOCK_ENABLED=true
