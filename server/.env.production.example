# Copy to server/.env.production on the host. Never commit the real file.
BOOKPILE_SERVER_ENVIRONMENT=production
BOOKPILE_SERVER_DEPLOYMENT_REVISION=replace-with-git-commit
BOOKPILE_SERVER_PUBLIC_BASE_URL=https://books.example.com
BOOKPILE_SERVER_ALLOWED_HOSTS=books.example.com
BOOKPILE_SERVER_API_DOCS_ENABLED=false
BOOKPILE_SERVER_SESSION_COOKIE_SECURE=true
BOOKPILE_SERVER_SESSION_COOKIE_NAME=bookpile_production_session
BOOKPILE_SERVER_CSRF_COOKIE_NAME=bookpile_production_csrf
BOOKPILE_SERVER_RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-characters
BOOKPILE_SERVER_DATABASE_URL=postgresql+psycopg://bookpile:replace-database-password@db:5432/bookpile
BOOKPILE_SERVER_DATABASE_POOL_SIZE=5
BOOKPILE_SERVER_DATABASE_MAX_OVERFLOW=5
BOOKPILE_SERVER_DATABASE_POOL_RECYCLE_SECONDS=1800
BOOKPILE_SERVER_PRIVATE_OBJECT_BACKEND=s3
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ENDPOINT_URL=https://s3.example-provider.es
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_REGION=replace-with-provider-region
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_BUCKET=replace-with-private-bucket
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ACCESS_KEY_ID=replace-with-least-privilege-key
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_SECRET_ACCESS_KEY=replace-with-secret-key
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_PREFIX=production
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_ADDRESSING_STYLE=auto
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_CONNECT_TIMEOUT_SECONDS=3
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_READ_TIMEOUT_SECONDS=10
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_MAX_ATTEMPTS=3
BOOKPILE_SERVER_PRIVATE_OBJECT_S3_MAX_CONNECTIONS=10
BOOKPILE_SERVER_SMTP_HOST=replace-in-phase-9c
BOOKPILE_SERVER_SMTP_PORT=587
BOOKPILE_SERVER_SMTP_FROM_EMAIL=BOOKPILE <noreply@books.example.com>
BOOKPILE_SERVER_SMTP_STARTTLS=true
BOOKPILE_SERVER_SMTP_USERNAME=replace-with-smtp-username
BOOKPILE_SERVER_SMTP_PASSWORD=replace-with-smtp-password
BOOKPILE_SERVER_SMTP_TIMEOUT_SECONDS=10
BOOKPILE_SERVER_EMAIL_DELIVERY_MODE=outbox
BOOKPILE_SERVER_EMAIL_OUTBOX_ENCRYPTION_SECRET=replace-with-independent-32-character-secret
BOOKPILE_SERVER_EMAIL_OUTBOX_MAX_ATTEMPTS=8
BOOKPILE_SERVER_EMAIL_OUTBOX_LEASE_SECONDS=120

# Compose/reverse-proxy variables (kept beside, but separate from, API settings).
BOOKPILE_POSTGRES_PASSWORD=replace-database-password
BOOKPILE_SITE_ADDRESS=https://books.example.com
BOOKPILE_TLS_EMAIL=operations@example.com
