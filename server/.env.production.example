# Copy to server/.env.production on the host. Never commit the real file.
BOOKPILE_SERVER_ENVIRONMENT=production
BOOKPILE_SERVER_DEPLOYMENT_REVISION=replace-with-git-commit
BOOKPILE_SERVER_PUBLIC_BASE_URL=https://books.example.com
BOOKPILE_SERVER_ALLOWED_HOSTS=books.example.com
BOOKPILE_SERVER_API_DOCS_ENABLED=false
BOOKPILE_SERVER_SESSION_COOKIE_SECURE=true
BOOKPILE_SERVER_SESSION_COOKIE_NAME=bookpile_production_session
BOOKPILE_SERVER_CSRF_COOKIE_NAME=bookpile_production_csrf
BOOKPILE_SERVER_RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-characters
BOOKPILE_SERVER_DATABASE_URL=postgresql+psycopg://bookpile:replace-database-password@db:5432/bookpile
BOOKPILE_SERVER_DATABASE_POOL_SIZE=5
BOOKPILE_SERVER_DATABASE_MAX_OVERFLOW=5
BOOKPILE_SERVER_DATABASE_POOL_RECYCLE_SECONDS=1800
BOOKPILE_SERVER_SMTP_HOST=replace-in-phase-9c
BOOKPILE_SERVER_SMTP_PORT=587
BOOKPILE_SERVER_SMTP_FROM_EMAIL=BOOKPILE <noreply@books.example.com>

# Compose/reverse-proxy variables (kept beside, but separate from, API settings).
BOOKPILE_POSTGRES_PASSWORD=replace-database-password
BOOKPILE_SITE_ADDRESS=https://books.example.com
BOOKPILE_TLS_EMAIL=operations@example.com
